{
  "name": "documorph",
  "private": true,
  "version": "0.1.0",
  "description": "Konversi dokumen offline untuk Windows",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
